<?xml version="1.0"?>
<ruleset name="Monks Central">
	<description>WordPress-Extra, WordPress-Docs and PHPCompatibilityWP for the plugin.</description>

	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-sites-hq"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="MonksCentral"/>
				<element value="monks_central_"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4: one class per file named after the class, not class-*.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>

	<!-- The connector keeps the Classic Monks layout and names (cm_*, CM_*), so its code stays
	     comparable with Classic Monks Free and Pro; its tool descriptions document the abilities. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.YodaConditions">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.CodeAnalysis.AssignmentInTernaryCondition">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.DisallowMultipleAssignments">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.CommentedOutCode">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<exclude-pattern>/connector/*</exclude-pattern>
	</rule>
</ruleset>
